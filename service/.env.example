# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Pit Stop
APP_URL=http://localhost:5173
DATABASE_FILE=./data/pit-stop.db
LOG_LEVEL=debug

# self-hosted (default): no quotas. cloud: the quotas of Plans.ts (ADR-002 D3).
EDITION=self-hosted

# Directory of the built SPA. Set, the service serves it next to the API (the Docker image
# does). Left empty in development, where Vite serves the front.
WEB_DIST=

# --- identity ----------------------------------------------------------------
# Optional. Your own Google OAuth client, created in your own Google Cloud project. Left
# empty, sign-in is by email and password only.
GOOGLE_CLIENT_ID=

# Optional. Platform admin is configuration, never data (ADR-001 D8): nobody can grant it with a
# database write, only with a deploy. Comma separated. Grants /paddock.
PLATFORM_ADMIN_EMAILS=

SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# --- mail --------------------------------------------------------------------
# SMTP first, then Resend. With neither, emails are not sent and their link is printed to the
# logs, in production too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465), false for STARTTLS.
SMTP_SECURE=false
RESEND_API_KEY=
MAIL_FROM=Pit Stop <noreply@mail.example.com>
