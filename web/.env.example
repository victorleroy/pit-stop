# The dev server proxies /api and /ws to the service. Override if 3000 is taken.
# VITE_PROXY_TARGET=http://localhost:3001
# Leave empty: the front and the API share one origin, through the Vite proxy in development
# and through the service itself in the Docker image. Only for a front hosted elsewhere:
# VITE_API_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com/ws
